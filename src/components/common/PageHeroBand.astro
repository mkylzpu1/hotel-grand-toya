---
// ページ上部の共通タイトル帯（パンくず＋英字ラベル＋タイトル）
// 温泉ページ・客室ページなど、下層ページ間でレイアウトを統一するための共通コンポーネント。
interface Props {
  icon: string;
  pageTitle: string;
  pageTitleEn: string;
  homeHref: string;
}

const { icon, pageTitle, pageTitleEn, homeHref } = Astro.props;
---

<section
  class="relative overflow-hidden bg-[#16283A] pb-14 pt-[132px] text-white lg:pb-[68px] lg:pt-[136px]"
>
  <span
    aria-hidden="true"
    class="lg:-top-34 pointer-events-none absolute -right-6 -top-16 select-none font-serif text-[220px] leading-none text-white/[0.05] lg:-right-4 lg:text-[300px]"
  >
    {icon}
  </span>
  <div class="relative mx-auto max-w-[1320px] px-5 lg:px-10">
    <!-- パンくずリスト -->
    <nav aria-label="パンくずリスト" class="mb-7">
      <ol class="flex flex-wrap items-center gap-2 text-[0.74rem] tracking-[0.06em] text-white/50">
        <li>
          <a href={homeHref} class="transition-colors hover:text-white">ホーム</a>
        </li>
        <li aria-hidden="true" class="text-white/30">/</li>
        <li class="text-white/85" aria-current="page">{pageTitle}</li>
      </ol>
    </nav>
    <p class="mb-4 text-[0.78rem] font-medium tracking-[0.2em] text-white/60">
      {pageTitleEn}
    </p>
    <h1
      class="font-serif text-[clamp(1.9rem,1.5rem+1.6vw,2.6rem)] font-semibold tracking-[0.06em] text-white"
    >
      {pageTitle}
    </h1>
  </div>
</section>
