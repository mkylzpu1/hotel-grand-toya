---
// 写真が未用意の項目に使う仮置きプレースホルダー。
// 破綻した<img>を出さず、撮影予定であることが伝わるプレーンな代替表示にする。
interface Props {
  label: string;
  class?: string;
}

const { label, class: className = '' } = Astro.props as Props;
---

<div
  class={`flex h-full w-full flex-col items-center justify-center gap-2 border border-dashed border-[#c9c8c3] bg-[#F1F0EC] text-[#8A8781] ${className}`}
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="h-6 w-6 opacity-70"
  >
    <rect x="3" y="6" width="18" height="13" rx="1.2" />
    <circle cx="9.5" cy="12" r="2.2" />
    <path d="M8 6l1.3-1.8h5.4L16 6" />
  </svg>
  <span class="px-2 text-center text-[0.68rem] leading-tight tracking-[0.06em]">
    {label}<br />
    <span class="opacity-70">Photo Coming Soon</span>
  </span>
</div>
