---
// 客室詳細の写真ギャラリー。1枚目（客室全体）を大きく、残り3枚を並べる
// サイト共通の「不揃いなモザイク」の非対称構成に合わせたレイアウト。
import PlaceholderImage from './PlaceholderImage.astro';

interface GalleryItem {
  label: string;
  src?: string;
  alt?: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props as Props;
const [main, ...rest] = items;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:auto-rows-[110px] lg:auto-rows-[130px]">
  {
    main && (
      <figure class="relative m-0 sm:col-start-1 sm:row-start-1 sm:row-span-3">
        {main.src ? (
          <img src={main.src} alt={main.alt || main.label} class="h-full w-full object-cover" />
        ) : (
          <PlaceholderImage label={main.label} />
        )}
        <figcaption class="mt-2.5 text-[0.78rem] tracking-[0.06em] text-[#55524C]">
          {main.label}
        </figcaption>
      </figure>
    )
  }
  {
    rest.map((item) => (
      <figure class="relative m-0 sm:col-start-2">
        {item.src ? (
          <img src={item.src} alt={item.alt || item.label} class="h-full w-full object-cover" />
        ) : (
          <PlaceholderImage label={item.label} />
        )}
        <figcaption class="mt-2.5 text-[0.78rem] tracking-[0.06em] text-[#55524C]">{item.label}</figcaption>
      </figure>
    ))
  }
</div>
