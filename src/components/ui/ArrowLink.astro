---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href?: string;
}

const { href = '#', class: className = '', ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2.5 border-b border-[#A24730] pb-[5px] text-[0.82rem] font-medium tracking-[0.05em] text-[#29415C] transition-colors hover:border-[#7E3623] hover:text-[#7E3623]',
    className,
  ]}
  {...rest}
>
  <slot /> →
</a>
