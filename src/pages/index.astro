---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/top/Hero.jsx';
import ContentSection from '../components/top/ContentSection.jsx';
import Access from '../components/top/Access.jsx';
import { sections } from '../data/top/sections.js';
---
<Layout>
  <main id="top">
    <Hero client:load />
    {sections.map((section) => (
      <ContentSection {...section} />
    ))}
    <Access />
  </main>
</Layout>
