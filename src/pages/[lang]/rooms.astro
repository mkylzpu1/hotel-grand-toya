---
import PageTemplate from '../../layouts/PageTemplate.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import { type Locale } from '../../content/config';
import { getLocalizedStaticPaths, getPageContext } from '../../utils/pageContext';
import AmenityIcon from '../../components/common/AmenityIcon.astro';

export async function getStaticPaths() {
  return getLocalizedStaticPaths('rooms-page');
}

const { lang } = Astro.params as { lang: Locale };

const { siteEntry, navigationEntry, pageEntry, relatedLinksData, langLinks } = await getPageContext(
  lang,
  'rooms-page',
  'rooms',
);

const page = pageEntry.data;
---

<PageTemplate
  lang={lang}
  title={`${page.pageTitle}｜${siteEntry.data.title}`}
  description={siteEntry.data.description}
  navigation={navigationEntry.data}
  site={siteEntry.data}
  langLinks={langLinks}
  heroIcon={page.intro.icon}
  pageTitle={page.pageTitle}
  pageTitleEn={page.pageTitleEn}
  quickNav={page.quickNav}
  quickNavLabel="客室タイプ"
  currentPageId="rooms"
  relatedLinksHeading={relatedLinksData.heading}
  relatedLinks={relatedLinksData.links}
  reservationLabel={siteEntry.data.reservationLabel}
>
  <!-- 和室セクション／洋室セクション -->
  {
    page.sections.map((section, sectionIndex) => (
      <section
        id={`section-${section.id}`}
        class={`scroll-mt-6 py-[88px] lg:py-[108px] ${sectionIndex % 2 === 1 ? 'bg-[#FAFAFA]' : ''}`}
      >
        <div class="mx-auto max-w-[1320px] px-5 lg:px-10">
          {/* 選べる客室タイプ（見出しは旧・和室セクションのSectionEyebrowを流用） */}
          <div class="space-y-[88px] lg:space-y-[108px]">
            {section.rooms.map((room) => (
              <div
                id={room.id}
                class="scroll-mt-6 border-t border-[#D8D7D2] pt-14 first:border-t-0 first:pt-0"
              >
                {/* 客室タイプの見出し（通し番号・名称・概要説明） */}
                <div class="mb-12 max-w-[760px]">
                  <SectionEyebrow icon={room.icon} eyebrow={room.eyebrow} heading={room.name} />
                  <div class="mt-6">
                    {room.description.map((line) => (
                      <p class="mb-3 text-[0.9rem] leading-[1.9] text-[#55524C] last:mb-0">
                        {line}
                      </p>
                    ))}
                  </div>
                </div>
                {/* 共通レイアウト：代表写真1枚＋基本情報 */}
                <div class="mb-16 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
                  <div class="aspect-[4/3] overflow-hidden">
                    <img
                      src={room.image.src}
                      alt={room.image.alt}
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div>
                    <table class="w-full border-t border-[#D8D7D2] text-[0.86rem]">
                      <tbody>
                        {room.basicInfo?.map((item) => (
                          <tr class="border-b border-[#D8D7D2]">
                            <th
                              scope="row"
                              class="w-[35%] py-3.5 pr-4 text-left font-medium tracking-[0.04em] text-[#8A8781]"
                            >
                              {item.label}
                            </th>
                            <td class="py-3.5 text-[#1E1C1A]">{item.value}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    {room.priceFrom && (
                      <div class="mt-4 border border-[#A24730]/[0.18] bg-[#FAF6F3] px-4 py-3.5">
                        <div class="mb-2 flex items-center gap-2">
                          <span class="flex h-4 w-4 shrink-0 -rotate-3 items-center justify-center rounded-[1px] border-[1.5px] border-[#A24730] font-serif text-[0.55rem] font-bold leading-none text-[#A24730]">
                            泊
                          </span>
                          <span class="text-[0.66rem] font-medium tracking-[0.12em] text-[#A24730]">
                            {room.priceLabel}
                          </span>
                        </div>
                        <p class="font-serif text-[1.55rem] font-semibold tracking-[0.02em] text-[#7E3623]">
                          {room.priceFrom}
                        </p>
                        {page.priceNote && (
                          <p class="text-[0.72rem] leading-[1.8] tracking-[0.02em] text-[#8A8781]">
                            ※ {page.priceNote}
                          </p>
                        )}
                      </div>
                    )}
                    {page.importantNotice && (
                      <div class="mx-auto mt-4 max-w-[1320px]">
                        <div class="flex items-start gap-3 border border-[#A24730]/30 bg-[#FAF6F3] px-5 py-4">
                          <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#A24730] text-[0.68rem] font-bold text-[#A24730]">
                            !
                          </span>
                          <p class="text-[0.84rem] leading-[1.85] text-[#55524C]">
                            {page.importantNotice}
                          </p>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                {/* フロアごとのサブセクション：可変グリッド写真（1〜3枚）＋右側に説明。フロア情報が無ければ非表示 */}
                {room.floors && room.floors.length > 0 && (
                  <div class="space-y-14">
                    {room.floors.map((floor) => (
                      <div>
                        {/* フロアごとのサブセクション見出し */}
                        <h4 class="mb-8 inline-block border-b-2 border-[#A24730] pb-2 font-serif text-[1.2rem] font-bold tracking-[0.04em] text-[#1E1C1A]">
                          {floor.label}
                        </h4>
                        <p class="mb-6 text-[0.76rem] tracking-[0.02em] text-[#8A8781]">
                          予約サイトでは「{floor.reservationName}」として掲載されています
                        </p>
                        {floor.badges && floor.badges.length > 0 && (
                          <ul class="mb-6 flex flex-wrap gap-2">
                            {floor.badges.map((badge) => (
                              <li class="rounded-[2px] border border-[#A24730]/40 px-2.5 py-1 text-[0.72rem] tracking-[0.03em] text-[#A24730]">
                                {badge}
                              </li>
                            ))}
                          </ul>
                        )}
                        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3 lg:gap-10">
                          {/* 写真グリッド（1〜3枚、可変） */}
                          {floor.images && floor.images.length > 0 && (
                            <div
                              class={`grid gap-3 lg:col-span-2 ${
                                floor.images.length === 1
                                  ? 'grid-cols-1'
                                  : floor.images.length === 3
                                    ? 'grid-cols-3'
                                    : 'grid-cols-2'
                              }`}
                            >
                              {floor.images.map((img) => (
                                <div class="aspect-[4/3] overflow-hidden">
                                  <img
                                    src={img.src}
                                    alt={img.alt}
                                    class="h-full w-full object-cover"
                                    loading="lazy"
                                  />
                                </div>
                              ))}
                            </div>
                          )}
                          {/* 右：フロア固有の説明文 */}
                          <div class="lg:col-span-1">
                            {floor.description.map((line) => (
                              <p class="mb-3 text-[0.88rem] leading-[1.9] text-[#55524C] last:mb-0">
                                {line}
                              </p>
                            ))}
                            {floor.isFirstFloor && (
                              <div class="mt-8 border border-[#D8D7D2] bg-[#FAFAFA] p-5">
                                <p class="mb-2.5 text-[0.78rem] font-medium tracking-[0.06em] text-[#29415C]">
                                  {page.firstFloorNotice.heading}
                                </p>
                                <ul class="space-y-1.5">
                                  {page.firstFloorNotice.items.map((note) => (
                                    <li class="text-[0.8rem] leading-[1.8] text-[#55524C]">
                                      ※ {note}
                                    </li>
                                  ))}
                                </ul>
                              </div>
                            )}
                            {/* 予約ボタン（フロア／プランごと） */}
                            <div class="mt-8">
                              <a
                                href={floor.reservationUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center justify-center gap-2 rounded-[2px] bg-[#C2622B] px-8 py-3 text-[0.84rem] font-medium tracking-[0.06em] text-white transition-colors hover:bg-[#A8531F]"
                              >
                                {page.detailCtaText}
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }
  <!-- チェックイン/アウト・支払い・キャンセル規定の案内バー -->
  <section class="border-b border-[#D8D7D2] bg-[#FAF6F0] px-5 py-8 lg:px-10">
    <div class="mx-auto grid max-w-[1320px] grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
      {
        [
          { label: page.stayNotice.checkInLabel, value: page.stayNotice.checkInValue },
          { label: page.stayNotice.checkOutLabel, value: page.stayNotice.checkOutValue },
          { label: page.stayNotice.paymentLabel, value: page.stayNotice.paymentValue },
          { label: page.stayNotice.cancellationLabel, value: page.stayNotice.cancellationValue },
        ].map((item) => (
          <div>
            <p class="mb-1 text-[0.72rem] tracking-[0.08em] text-[#A24730]">{item.label}</p>
            <p class="text-[0.88rem] leading-[1.6] text-[#1E1C1A]">{item.value}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 共通アメニティ（和室・洋室で共通。ページ下部に1回だけ掲載） -->
  <section id="section-amenities" class="scroll-mt-6 py-[88px] lg:py-[108px]">
    <div class="mx-auto max-w-[1320px] px-5 lg:px-10">
      <div class="mb-14 max-w-[760px]">
        <SectionEyebrow
          icon={page.amenitiesIcon}
          eyebrow={page.amenitiesEyebrow}
          heading={page.amenitiesHeading}
        />
      </div>
      <ul class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {
          page.commonAmenities.map((amenity) => (
            <li class="flex flex-col items-center gap-3 text-center">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#29415C] text-[#29415C]">
                <AmenityIcon iconKey={amenity.key} />
              </span>
              <div>
                <p class="text-[0.8rem] leading-[1.7] text-[#55524C]">{amenity.label}</p>
                {amenity.note && (
                  <p class="mt-1 text-[0.72rem] leading-[1.5] text-[#A24730]">※ {amenity.note}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <!-- 客室セクションなど（これまでの実装） -->
</PageTemplate>
