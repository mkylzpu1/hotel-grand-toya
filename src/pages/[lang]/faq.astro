---
import PageTemplate from '../../layouts/PageTemplate.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import { type Locale } from '../../content/config';
import { getLocalizedStaticPaths, getPageContext } from '../../utils/pageContext';

export async function getStaticPaths() {
  return getLocalizedStaticPaths('faq-page');
}

const { lang } = Astro.params as { lang: Locale };

const { siteEntry, navigationEntry, pageEntry, relatedLinksData, langLinks } = await getPageContext(
  lang,
  'faq-page',
  'faq',
);

const page = pageEntry.data;
---

<PageTemplate
  lang={lang}
  title={`${page.pageTitle}｜${siteEntry.data.title}`}
  description={siteEntry.data.description}
  navigation={navigationEntry.data}
  site={siteEntry.data}
  langLinks={langLinks}
  heroIcon={page.icon}
  pageTitle={page.pageTitle}
  pageTitleEn={page.pageTitleEn}
  quickNavLabel="ページ内ナビゲーション"
  currentPageId="faq"
  relatedLinksHeading={relatedLinksData.heading}
  relatedLinks={relatedLinksData.links}
  relatedLinksBackground="none"
>
  <!-- Q&A一覧 -->
  <section class="bg-white/95 py-[88px] lg:py-[108px]">
    <div class="mx-auto max-w-[840px] px-6 sm:px-10">
      <!-- セクション見出し -->
      <div class="mb-10 max-w-[760px]">
        <SectionEyebrow
          icon={page.qaSection.icon}
          eyebrow={page.qaSection.eyebrow}
          heading={page.qaSection.heading}
        />
      </div>

      <!-- カテゴリタブ -->
      <div
        id="faq-tablist"
        role="tablist"
        aria-label="質問カテゴリ"
        class="mb-14 flex flex-wrap gap-2"
      >
        {
          page.categories.map((cat, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${cat.id}`}
              aria-controls={`panel-${cat.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              data-category={cat.id}
              class:list={[
                'faq-tab',
                'flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full border px-5 py-2.5 text-[0.82rem] font-medium transition-colors',
                i === 0
                  ? 'border-[#A24730] bg-[#A24730] text-white'
                  : 'border-[#C7C5BF] bg-white text-[#55524C] hover:border-[#A24730] hover:text-[#A24730]',
              ]}
            >
              <span class="font-serif text-[0.9rem]">{cat.icon}</span>
              {cat.label}
            </button>
          ))
        }
      </div>

      {
        page.categories.map((cat, i) => (
          <div
            id={`panel-${cat.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${cat.id}`}
            data-category-panel={cat.id}
            class="faq-panel"
            hidden={i !== 0}
          >
            <div class="divide-y divide-[#C7C5BF] border-y border-[#C7C5BF]">
              {cat.items.map((item) => (
                <div class="faq-item">
                  <button
                    type="button"
                    class="faq-question flex w-full items-start justify-between gap-4 py-5 text-left"
                    aria-expanded="false"
                  >
                    <span class="flex-1">
                      <span class="mr-2 font-serif text-[0.9rem] font-bold text-[#A24730]">Q.</span>
                      <span class="text-[0.92rem] font-medium leading-[1.7] text-[#1E1C1A]">
                        {item.question}
                      </span>
                    </span>
                    <span class="faq-icon mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#A24730] text-[0.85rem] text-[#A24730] transition-transform duration-300">
                      ＋
                    </span>
                  </button>
                  <div class="faq-answer-wrap">
                    <div class="faq-answer-inner overflow-hidden">
                      <div class="flex items-start gap-4 pb-6 pl-0 pr-11">
                        <span class="font-serif text-[0.9rem] font-bold text-[#29415C]">A.</span>
                        <p class="flex-1 text-[0.86rem] leading-[1.9] text-[#55524C]">
                          {item.answer}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }

      <!-- 問い合わせ先 -->
      <div class="mt-20 border border-[#D8D7D2] bg-[#FAFAFA] px-8 py-12 sm:px-14">
        <p class="mb-8 text-center text-[0.82rem] tracking-[0.04em] text-[#8A8781]">
          ご不明な点がございましたら、お気軽にお問い合わせください
        </p>
        <div class="mx-auto grid max-w-[560px] grid-cols-1 gap-6 sm:grid-cols-2">
          <!-- 電話 -->
          <a
            href={`tel:${page.contact.tel.replace(/-/g, '')}`}
            class="group flex flex-col items-center gap-3 border border-[#D8D7D2] bg-white px-6 py-8 text-center transition-shadow hover:shadow-[0_4px_16px_rgba(30,28,26,0.06)]"
          >
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#A24730] text-[1rem] text-[#A24730]"
            >
              ☎
            </span>
            <span
              class="font-serif text-[1.25rem] font-semibold tracking-[0.02em] text-[#1E1C1A] transition-colors group-hover:text-[#A24730]"
            >
              {page.contact.tel}
            </span>
            {
              page.contact.telNote && (
                <span class="text-[0.74rem] text-[#8A8781]">{page.contact.telNote}</span>
              )
            }
          </a>
          <!-- メール -->
          <a
            href={`mailto:${page.contact.email}`}
            class="group flex flex-col items-center gap-3 border border-[#D8D7D2] bg-white px-6 py-8 text-center transition-shadow hover:shadow-[0_4px_16px_rgba(30,28,26,0.06)]"
          >
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-[#29415C] text-[1rem] text-[#29415C]"
            >
              ✉
            </span>
            <span
              class="break-all font-serif text-[0.98rem] font-semibold tracking-[0.02em] text-[#1E1C1A] transition-colors group-hover:text-[#29415C]"
            >
              {page.contact.email}
            </span>
            <span class="text-[0.74rem] text-[#8A8781]">メールでのお問い合わせ</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</PageTemplate>

<style>
  /* アコーディオン：grid-template-rowsで滑らかに開閉 */
  .faq-answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms ease;
  }
  .faq-item.is-open .faq-answer-wrap {
    grid-template-rows: 1fr;
  }
  .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
  }

  /* 選択中タブは hover しても色が変わらないよう固定する */
  .faq-tab[aria-selected='true']:hover {
    background-color: #a24730;
    color: #ffffff;
    border-color: #a24730;
  }
</style>

<script>
  const tablist = document.getElementById('faq-tablist');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-category-panel]'));

  // --- タブ切り替え（クリック・hash両方から呼べるよう関数化） ---
  function activateTab(target: string, { scroll = true }: { scroll?: boolean } = {}) {
    const tab = tabs.find((t) => t.dataset['category'] === target);
    if (!tab) return false;
    tabs.forEach((t) => {
      const active = t.dataset['category'] === target;
      t.setAttribute('aria-selected', String(active));
      t.classList.toggle('border-[#A24730]', active);
      t.classList.toggle('bg-[#A24730]', active);
      t.classList.toggle('text-white', active);
      t.classList.toggle('border-[#C7C5BF]', !active);
      t.classList.toggle('bg-white', !active);
      t.classList.toggle('text-[#55524C]', !active);
    });
    panels.forEach((p) => {
      p.hidden = p.dataset['categoryPanel'] !== target;
    });
    if (scroll) {
      tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }
    return true;
  }

  tablist?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.faq-tab');
    if (!btn) return;
    activateTab(btn.dataset['category']!);
  });

  // --- アコーディオン開閉 ---
  function openFaqItem(item: HTMLElement) {
    const question = item.querySelector<HTMLButtonElement>('.faq-question');
    item.classList.add('is-open');
    question?.setAttribute('aria-expanded', 'true');
  }
  document.querySelectorAll<HTMLElement>('.faq-item').forEach((item) => {
    const question = item.querySelector<HTMLButtonElement>('.faq-question');
    question?.addEventListener('click', () => {
      const isOpen = item.classList.toggle('is-open');
      question.setAttribute('aria-expanded', String(isOpen));
    });
  });

  // --- 検索結果からの遷移: #カテゴリID を見てタブを開く ---
  function applyHashNavigation() {
    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (!hash) return;
    const opened = activateTab(hash, { scroll: false });
    if (opened) {
      // タブ切り替え後、パネル自体までスクロール
      requestAnimationFrame(() => {
        document
          .getElementById(`panel-${hash}`)
          ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  // --- 検索結果からの遷移: ?highlight=キーワード で該当質問を開いてハイライト ---
  function applyHighlight() {
    const params = new URLSearchParams(location.search);
    const term = params.get('highlight')?.trim().toLowerCase();
    if (!term) return;

    for (const item of document.querySelectorAll<HTMLElement>('.faq-item')) {
      const text = item.textContent?.toLowerCase() ?? '';
      if (!text.includes(term)) continue;

      // このFAQ項目が属するカテゴリタブを開く
      const panel = item.closest<HTMLElement>('[data-category-panel]');
      const category = panel?.dataset['categoryPanel'];
      if (category) activateTab(category, { scroll: false });

      openFaqItem(item);
      requestAnimationFrame(() => {
        item.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      break; // 最初に一致した項目のみ開く
    }
  }

  applyHashNavigation();
  applyHighlight();
  window.addEventListener('hashchange', applyHashNavigation);
</script>
