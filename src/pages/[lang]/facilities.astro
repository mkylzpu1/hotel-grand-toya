---
import PageTemplate from '../../layouts/PageTemplate.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import { type Locale } from '../../content/config';
import { getLocalizedStaticPaths, getPageContext } from '../../utils/pageContext';
import { Footprints, Car, Star, Ticket, MapPin, ExternalLink, Store } from 'lucide-astro';
import AmenityIcon from '../../components/common/AmenityIcon.astro';
import { getEntry } from 'astro:content';
export async function getStaticPaths() {
  return getLocalizedStaticPaths('facilities-page');
}
const { lang } = Astro.params as { lang: Locale };
const { siteEntry, navigationEntry, pageEntry, relatedLinksData, langLinks } = await getPageContext(
  lang,
  'facilities-page',
  'facilities',
);
const page = pageEntry.data;
const [
  pageMetaEntry,
  facilitiesSectionEntry,
  servicesSectionEntry,
  activitiesSectionEntry,
  usageNoticeEntry,
  legacyContentEntry,
] = await Promise.all([
  getEntry('facilities-page-meta', `facilities-page-meta.${lang}`),
  getEntry('facilities-section', `facilities-section.${lang}`),
  getEntry('facilities-services', `facilities-services.${lang}`),
  getEntry('facilities-activities', `facilities-activities.${lang}`),
  getEntry('facilities-usage-notice', `facilities-usage-notice.${lang}`),
  getEntry('facilities-content', `facilities-content.${lang}`),
]);
const pageMeta = pageMetaEntry?.data ?? {
  pageTitle: page.pageTitle,
  pageTitleEn: page.pageTitleEn,
  intro: page.intro,
  icon: page.icon,
  quickNav: page.quickNav,
};
const legacyContent = legacyContentEntry?.data ?? {
  facilitiesSection: page.facilitiesSection,
  servicesSection: page.servicesSection,
  activitiesSection: page.activitiesSection,
  usageNotice: page.usageNotice,
};
const content = {
  facilitiesSection:
    facilitiesSectionEntry?.data ?? legacyContent.facilitiesSection ?? page.facilitiesSection,
  servicesSection:
    servicesSectionEntry?.data ?? legacyContent.servicesSection ?? page.servicesSection,
  activitiesSection:
    activitiesSectionEntry?.data ?? legacyContent.activitiesSection ?? page.activitiesSection,
  usageNotice: usageNoticeEntry?.data ?? legacyContent.usageNotice ?? page.usageNotice,
};
// 未確定項目のフォールバック表示
const withFallback = (value?: string) => value || content.facilitiesSection?.contactFallbackLabel;
function getAccessIcon(accessText?: string) {
  if (!accessText) return null;
  if (accessText.includes('徒歩')) return 'walk';
  if (accessText.includes('車')) return 'car';
  return null;
}
const partnerActivities = (content.activitiesSection?.items ?? []).filter((item) => item.isPartner);
const otherActivities = (content.activitiesSection?.items ?? []).filter((item) => !item.isPartner);
---

<PageTemplate
  lang={lang}
  title={`${pageMeta.pageTitle}｜${siteEntry.data.title}`}
  description={siteEntry.data.description}
  navigation={navigationEntry.data}
  site={siteEntry.data}
  langLinks={langLinks}
  heroIcon={pageMeta.icon}
  pageTitle={pageMeta.pageTitle}
  pageTitleEn={pageMeta.pageTitleEn}
  quickNav={pageMeta.quickNav}
  quickNavLabel="ページ内ナビゲーション"
  currentPageId="facilities"
  relatedLinksHeading={relatedLinksData.heading}
  relatedLinks={relatedLinksData.links}
  reservationLabel={siteEntry.data.reservationLabel}
  relatedLinksBackground="none"
>
  <section class="mx-auto max-w-[1320px] px-5 py-[88px] lg:px-10 lg:py-[108px]">
    <SectionEyebrow
      icon={pageMeta.intro.icon}
      eyebrow={pageMeta.intro.eyebrow}
      heading={pageMeta.intro.heading}
    />
    <div class="mt-8 max-w-[640px]">
      {
        pageMeta.intro.description.map((line) => (
          <p class="mb-4 text-[0.94rem] leading-[1.9] text-[#55524C] last:mb-0">{line}</p>
        ))
      }
    </div>
  </section>
  {/* 館内施設 */}
  <section id="section-facilities" class="scroll-mt-6 bg-[#FAFAFA] py-[88px] lg:py-[108px]">
    <div class="mx-auto max-w-[1320px] px-5 lg:px-10">
      <div class="mb-14 max-w-[760px]">
        <SectionEyebrow
          icon={content.facilitiesSection.icon}
          eyebrow={content.facilitiesSection.eyebrow}
          heading={content.facilitiesSection.heading}
        />
      </div>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          content.facilitiesSection.items.map((item) => (
            <div id={item.id} class="scroll-mt-24 border border-[#D8D7D2] bg-white">
              <div class="aspect-[4/3] overflow-hidden bg-[#EFEDE8]">
                <img
                  src={item.image?.src}
                  alt={item.image?.alt ?? item.name}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="px-6 py-6">
                <div class="mb-2 flex items-center gap-2">
                  <span class="h-[16px] w-[2.5px] shrink-0 bg-[#A24730]" />
                  <h4 class="font-serif text-[1.05rem] font-semibold text-[#1E1C1A]">
                    {item.name}
                  </h4>
                </div>
                {item.description.map((line) => (
                  <p class="mb-2 text-[0.84rem] leading-[1.8] text-[#55524C] last:mb-0">{line}</p>
                ))}
                <div class="mt-3 flex flex-col gap-1.5 border-t border-[#EDEBE6] pt-3 text-[0.78rem] text-[#8A8781]">
                  {(item.hours || item.location) && (
                    <div class="flex justify-between gap-2">
                      <dt>{content.facilitiesSection.hoursLabel}</dt>
                      <dd class="text-right text-[#1E1C1A]">
                        {withFallback(item.hours ?? item.location)}
                      </dd>
                    </div>
                  )}
                  {item.fee && (
                    <div class="flex justify-between gap-2">
                      <dt>{content.facilitiesSection.feeLabel}</dt>
                      <dd class="text-right text-[#1E1C1A]">{item.fee}</dd>
                    </div>
                  )}
                  {item.payment && (
                    <div class="flex justify-between gap-2">
                      <dt>{content.facilitiesSection.paymentLabel}</dt>
                      <dd class="text-right text-[#1E1C1A]">{item.payment}</dd>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  {/* 館内サービス */}
  <section id="section-services" class="scroll-mt-6 py-[88px] lg:py-[108px]">
    <div class="mx-auto max-w-[1320px] px-5 lg:px-10">
      <div class="mb-14 max-w-[760px]">
        <SectionEyebrow
          icon={content.servicesSection.icon}
          eyebrow={content.servicesSection.eyebrow}
          heading={content.servicesSection.heading}
        />
      </div>
      {/* メインカード（マッサージ）：周辺アクティビティの提携カードに準拠 */}
      {
        content.servicesSection.items
          .filter((item) => item.isFeatured)
          .map((item) => (
            <div
              id={item.id}
              class="mb-14 grid scroll-mt-24 grid-cols-1 overflow-hidden border-2 border-[#A24730] bg-[#FAFAFA] sm:grid-cols-2"
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-[#EFEDE8] sm:aspect-auto">
                <img
                  src={item.image?.src}
                  alt={item.image?.alt ?? item.name}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col px-7 py-8">
                <div class="mb-2.5 flex items-center gap-3">
                  <span class="h-[20px] w-[3px] shrink-0 bg-[#A24730]" />
                  <h4 class="font-serif text-[1.2rem] font-semibold text-[#1E1C1A]">{item.name}</h4>
                </div>
                {item.description.map((line) => (
                  <p class="mb-2 text-[0.88rem] leading-[1.85] text-[#55524C] last:mb-0">{line}</p>
                ))}
                <dl class="mt-5 space-y-2.5 text-[0.78rem] text-[#8A8781]">
                  <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
                    <dt class="shrink-0 sm:w-24">{content.servicesSection.feeLabel}</dt>
                    <dd class="text-[#1E1C1A] sm:flex-1 sm:text-right">{item.fee}</dd>
                  </div>
                  {item.plans && (
                    <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
                      <dt class="shrink-0 sm:w-24">{content.servicesSection.plansLabel}</dt>
                      <dd class="text-[#1E1C1A] sm:flex-1 sm:text-right">
                        {item.plans.join('／')}
                      </dd>
                    </div>
                  )}
                  <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
                    <dt class="shrink-0 sm:w-24">{content.servicesSection.receptionHoursLabel}</dt>
                    <dd class="text-[#1E1C1A] sm:flex-1 sm:text-right">{item.receptionHours}</dd>
                  </div>
                  <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
                    <dt class="shrink-0 sm:w-24">
                      {content.servicesSection.reservationMethodLabel}
                    </dt>
                    <dd class="text-[#1E1C1A] sm:flex-1 sm:text-right">{item.reservationMethod}</dd>
                  </div>
                </dl>
              </div>
            </div>
          ))
      }
      {/* その他の館内サービス（リスト） */}
      <div class="border-l border-t border-[#D8D7D2] lg:grid lg:grid-cols-3">
        {
          content.servicesSection.items
            .filter((item) => !item.isFeatured)
            .map((item) => (
              <div
                id={item.id}
                class="scroll-mt-24 border-b border-r border-[#D8D7D2] bg-[#FAFAFA] px-4 py-4 lg:px-5 lg:py-[18px]"
              >
                <div class="flex items-center gap-2.5 lg:gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#A24730] lg:h-[38px] lg:w-[38px]">
                    <AmenityIcon
                      iconKey={item.icon}
                      class="h-4 w-4 text-[#A24730] lg:h-[17px] lg:w-[17px]"
                    />
                  </span>
                  <div class="flex-1">
                    <p class="font-serif text-[0.94rem] font-medium text-[#1E1C1A] lg:text-[1rem]">
                      {item.name}
                    </p>
                    <p class="mt-0.5 text-[0.78rem] leading-[1.6] text-[#8A8781] lg:mt-1 lg:text-[0.81rem] lg:leading-[1.7]">
                      {item.description[0]}
                    </p>
                  </div>
                </div>
                <div class="flex flex-wrap gap-1.5 pl-[46px] pt-2.5 lg:pl-[50px] lg:pt-3">
                  {item.fee && (
                    <span class="rounded-full bg-[#FAECE7] px-2.5 py-1 text-[0.69rem] text-[#712B13] lg:text-[0.72rem]">
                      {content.servicesSection.feeLabel} {item.fee}
                    </span>
                  )}
                  {item.hours && (
                    <span class="rounded-full bg-[#FAECE7] px-2.5 py-1 text-[0.69rem] text-[#712B13] lg:text-[0.72rem]">
                      {content.servicesSection.hoursLabel} {item.hours}
                    </span>
                  )}
                  {item.reservationMethod && (
                    <span class="rounded-full bg-[#F1EFE8] px-2.5 py-1 text-[0.69rem] text-[#444441] lg:text-[0.72rem]">
                      {item.reservationMethod}
                    </span>
                  )}
                </div>
              </div>
            ))
        }
      </div>
    </div>
  </section>
  {/* 周辺アクティビティ */}
  <section id="section-activities" class="scroll-mt-6 bg-[#FAFAFA] py-[88px] lg:py-[108px]">
    <div class="mx-auto max-w-[1320px] px-5 lg:px-10">
      <div class="mb-14 max-w-[760px]">
        <SectionEyebrow
          icon={content.activitiesSection.icon}
          eyebrow={content.activitiesSection.eyebrow}
          heading={content.activitiesSection.heading}
        />
      </div>
      {
        usageNoticeEntry.data.items.length > 0 && (
          <div class="mx-auto mb-4 max-w-[1320px]">
            <div class="flex items-start gap-3 border border-[#A24730]/30 bg-[#FAF6F3] px-5 py-4">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#A24730] text-[0.68rem] font-bold text-[#A24730]">
                !
              </span>
              {usageNoticeEntry.data.items.map((note) => (
                <p class="text-[0.84rem] leading-[1.85] text-[#55524C]">{note}</p>
              ))}
            </div>
          </div>
        )
      }
      {/* 提携アクティビティ（先頭・横長カード） */}
      {
        partnerActivities.length > 0 && (
          <div class="mb-14">
            <p class="mb-4 text-[0.78rem] font-medium tracking-[0.06em] text-[#A24730]">
              {content.activitiesSection.partnerHeading}
            </p>
            <div class="space-y-6">
              {partnerActivities.map((item) => (
                <div
                  id={item.id}
                  class="grid scroll-mt-24 grid-cols-1 overflow-hidden border-2 border-[#A24730] bg-white lg:grid-cols-[1.1fr_1.4fr]"
                >
                  <div class="relative aspect-[4/3] overflow-hidden bg-[#EFEDE8] lg:aspect-auto">
                    {item.image?.src ? (
                      <img
                        src={item.image.src}
                        alt={item.image.alt ?? item.image.label}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-[#A8A5A0]">
                        <span class="flex h-12 w-12 items-center justify-center rounded-full border border-[#C7C5BF] font-serif text-[1.1rem]">
                          {content.activitiesSection.icon}
                        </span>
                        <span class="text-[0.7rem] tracking-[0.06em]">{item.name}</span>
                      </div>
                    )}
                    <span class="absolute left-3 top-3 flex items-center gap-1.5 bg-[#A24730] px-2.5 py-1 text-[0.7rem] font-medium text-white">
                      <Star size={13} strokeWidth={2} />
                      {item.partnerBadgeLabel ?? content.activitiesSection.partnerBadgeDefaultLabel}
                    </span>
                    {item.accessFromHotel && (
                      <span class="absolute right-3 top-3 flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-[0.72rem] font-medium text-[#1E1C1A]">
                        {getAccessIcon(item.accessFromHotel) === 'walk' && (
                          <Footprints size={13} strokeWidth={2} />
                        )}
                        {getAccessIcon(item.accessFromHotel) === 'car' && (
                          <Car size={13} strokeWidth={2} />
                        )}
                        {item.accessFromHotel}
                      </span>
                    )}
                  </div>
                  <div class="flex flex-col px-7 py-8 lg:px-9">
                    <div class="mb-2.5 flex items-center gap-3">
                      <span class="h-[20px] w-[3px] shrink-0 bg-[#A24730]" />
                      <h4 class="font-serif text-[1.2rem] font-semibold tracking-[0.01em] text-[#1E1C1A]">
                        {item.name}
                      </h4>
                    </div>
                    {item.description.map((line) => (
                      <p class="mb-2 text-[0.88rem] leading-[1.85] text-[#55524C] last:mb-0">
                        {line}
                      </p>
                    ))}
                    {item.includedInPlans && item.includedInPlans.length > 0 && (
                      <div class="mt-5">
                        <p class="mb-2.5 text-[0.72rem] tracking-[0.02em] text-[#8A8781]">
                          {content.activitiesSection.includedInPlansHeading}
                        </p>
                        <div class="flex flex-wrap gap-2">
                          {item.includedInPlans.map((plan) => (
                            <a
                              href={plan.href}
                              class="inline-flex items-center gap-1.5 rounded-full border border-[#D8D7D2] bg-[#FAFAFA] px-3 py-1.5 text-[0.76rem] font-medium text-[#1E1C1A] transition-colors hover:border-[#A24730] hover:text-[#A24730]"
                            >
                              <Ticket size={13} strokeWidth={2} class="text-[#A24730]" />
                              {plan.name}
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                    <div class="mt-auto flex flex-col gap-1.5 pt-6 text-[0.78rem] text-[#8A8781]">
                      {item.shopName && (
                        <span class="flex items-center gap-1.5">
                          <Store size={14} strokeWidth={2} />
                          {item.shopName}
                        </span>
                      )}
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        {item.location && (
                          <span class="flex items-center gap-1.5">
                            <MapPin size={14} strokeWidth={2} />
                            {item.location}
                          </span>
                        )}
                        {item.location && item.officialSite && (
                          <span class="text-[#C7C5BF]">　</span>
                        )}
                        {item.officialSite && (
                          <a
                            href={item.officialSite}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group inline-flex items-center gap-1.5 rounded-full border border-[#A24730] px-3 py-1 text-[0.74rem] font-medium text-[#A24730] transition-colors hover:bg-[#A24730] hover:text-white"
                          >
                            {content.activitiesSection.officialSiteLinkLabel}
                            <ExternalLink
                              size={12}
                              strokeWidth={2}
                              class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                            />
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }
      {/* その他のアクティビティ（カテゴリタブ + グリッド/アコーディオン） */}
      {
        otherActivities.length > 0 && (
          <div>
            {partnerActivities.length > 0 && (
              <p class="mb-5 text-[0.78rem] font-medium tracking-[0.06em] text-[#8A8781]">
                {content.activitiesSection.otherHeading}
              </p>
            )}
            {/* カテゴリフィルタタブ */}
            <div id="activity-tablist" class="mb-8 flex flex-wrap gap-2">
              <button
                type="button"
                data-activity-category="all"
                class="activity-tab rounded-full border border-[#A24730] bg-[#A24730] px-4 py-2 text-[0.78rem] font-medium text-white transition-colors"
              >
                {content.activitiesSection.allCategoryLabel}
              </button>
              {content.activitiesSection.categoryFilters.map((cat) => (
                <button
                  type="button"
                  data-activity-category={cat.id}
                  class="activity-tab rounded-full border border-[#D8D7D2] bg-white px-4 py-2 text-[0.78rem] font-medium text-[#55524C] transition-colors"
                >
                  {cat.label}
                </button>
              ))}
            </div>

            {/* PC版：グリッドカード（lg以上のみ表示） */}
            <div
              id="activity-grid-desktop"
              class="hidden grid-cols-1 gap-8 sm:grid-cols-2 lg:grid lg:grid-cols-3"
            >
              {otherActivities.map((item) => (
                <div
                  id={item.id}
                  class="activity-card scroll-mt-24 border border-[#D8D7D2] bg-white"
                  data-categories={(item.categories ?? []).join(',')}
                >
                  <div class="relative aspect-[4/3] overflow-hidden bg-[#EFEDE8]">
                    {item.image?.src ? (
                      <img
                        src={item.image.src}
                        alt={item.image.alt ?? item.image.label}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-[#A8A5A0]">
                        <span class="flex h-12 w-12 items-center justify-center rounded-full border border-[#C7C5BF] font-serif text-[1.1rem]">
                          {content.activitiesSection.icon}
                        </span>
                        <span class="text-[0.7rem] tracking-[0.06em]">{item.name}</span>
                      </div>
                    )}
                    {item.accessFromHotel && (
                      <span class="absolute left-3 top-3 flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-[0.72rem] font-medium text-[#1E1C1A]">
                        {getAccessIcon(item.accessFromHotel) === 'walk' && (
                          <Footprints size={13} strokeWidth={2} />
                        )}
                        {getAccessIcon(item.accessFromHotel) === 'car' && (
                          <Car size={13} strokeWidth={2} />
                        )}
                        {item.accessFromHotel}
                      </span>
                    )}
                  </div>
                  <div class="px-6 py-6">
                    <div class="mb-2 flex items-center gap-2.5">
                      <span class="h-[16px] w-[2.5px] shrink-0 bg-[#A24730]" />
                      <h4 class="font-serif text-[1.05rem] font-semibold tracking-[0.01em] text-[#1E1C1A]">
                        {item.name}
                      </h4>
                    </div>
                    {item.categories && item.categories.length > 0 && (
                      <div class="mb-3 flex flex-wrap gap-1.5">
                        {item.categories.map((catId) => {
                          const cat = content.activitiesSection.categoryFilters.find(
                            (c) => c.id === catId,
                          );
                          return cat ? (
                            <span class="rounded-full bg-[#F7EAE5] px-2.5 py-1 text-[0.68rem] font-medium text-[#A24730]">
                              {cat.label}
                            </span>
                          ) : null;
                        })}
                      </div>
                    )}
                    {item.description.map((line) => (
                      <p class="mb-2 text-[0.84rem] leading-[1.8] text-[#55524C] last:mb-0">
                        {line}
                      </p>
                    ))}
                    {item.includedInPlans && item.includedInPlans.length > 0 && (
                      <div class="mt-3">
                        <p class="mb-2 text-[0.7rem] text-[#8A8781]">
                          {content.activitiesSection.includedInPlansHeadingShort}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                          {item.includedInPlans.map((plan) => (
                            <a
                              href={plan.href}
                              class="inline-flex items-center gap-1 rounded-full border border-[#D8D7D2] px-2.5 py-1 text-[0.72rem] font-medium text-[#1E1C1A] transition-colors hover:border-[#A24730] hover:text-[#A24730]"
                            >
                              <Ticket size={11} strokeWidth={2} class="text-[#A24730]" />
                              {plan.name}
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                    <div class="mt-3 flex flex-col gap-1.5 border-t border-[#EDEBE6] pt-3 text-[0.78rem] text-[#8A8781]">
                      {item.shopName && (
                        <span class="flex items-center gap-1.5">
                          <Store size={13} strokeWidth={2} />
                          {item.shopName}
                        </span>
                      )}
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        {item.location && (
                          <span class="flex items-center gap-1.5">
                            <MapPin size={13} strokeWidth={2} />
                            {item.location}
                          </span>
                        )}
                        {item.location && item.officialSite && (
                          <span class="text-[#C7C5BF]">　</span>
                        )}
                        {item.officialSite && (
                          <a
                            href={item.officialSite}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group inline-flex items-center gap-1.5 rounded-full border border-[#A24730] px-2.5 py-1 text-[0.7rem] font-medium text-[#A24730] transition-colors hover:bg-[#A24730] hover:text-white"
                          >
                            {content.activitiesSection.officialSiteLinkLabelShort}
                            <ExternalLink
                              size={11}
                              strokeWidth={2}
                              class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                            />
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            {/* モバイル版：アコーディオン（lg未満のみ表示） */}
            <div
              id="activity-list-mobile"
              class="divide-y divide-[#D8D7D2] border-y border-[#D8D7D2] lg:hidden"
            >
              {otherActivities.map((item) => (
                <details
                  id={item.id}
                  class="activity-card group scroll-mt-24 bg-white"
                  data-categories={(item.categories ?? []).join(',')}
                >
                  <summary class="flex cursor-pointer items-start gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden [&::marker]:content-none">
                    <div class="h-12 w-12 shrink-0 overflow-hidden rounded bg-[#EFEDE8]">
                      {item.image?.src ? (
                        <img
                          src={item.image.src}
                          alt={item.image.alt ?? item.image.label}
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center font-serif text-[0.9rem] text-[#A8A5A0]">
                          {content.activitiesSection.icon}
                        </div>
                      )}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="truncate font-serif text-[0.94rem] font-semibold text-[#1E1C1A]">
                        {item.name}
                      </p>
                      {item.accessFromHotel && (
                        <div class="mt-1 flex flex-wrap gap-1">
                          <span class="flex items-center gap-1 whitespace-nowrap rounded-full bg-[#F5F4F0] px-2 py-0.5 text-[0.66rem] font-medium text-[#55524C]">
                            {getAccessIcon(item.accessFromHotel) === 'walk' && (
                              <Footprints size={11} strokeWidth={2} />
                            )}
                            {getAccessIcon(item.accessFromHotel) === 'car' && (
                              <Car size={11} strokeWidth={2} />
                            )}
                            {item.accessFromHotel}
                          </span>
                        </div>
                      )}
                    </div>
                    <svg
                      class="mt-1 h-4 w-4 shrink-0 text-[#8A8781] transition-transform group-open:rotate-180"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path d="M5 7.5l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <div class="px-4 pb-5 pl-[68px]">
                    {item.description.map((line) => (
                      <p class="mb-2 text-[0.84rem] leading-[1.8] text-[#55524C] last:mb-0">
                        {line}
                      </p>
                    ))}
                    {item.includedInPlans && item.includedInPlans.length > 0 && (
                      <div class="mt-3">
                        <p class="mb-2 text-[0.7rem] text-[#8A8781]">
                          {content.activitiesSection.includedInPlansHeadingShort}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                          {item.includedInPlans.map((plan) => (
                            <a
                              href={plan.href}
                              class="inline-flex items-center gap-1 rounded-full border border-[#D8D7D2] px-2.5 py-1 text-[0.72rem] font-medium text-[#1E1C1A] transition-colors hover:border-[#A24730] hover:text-[#A24730]"
                            >
                              <Ticket size={11} strokeWidth={2} class="text-[#A24730]" />
                              {plan.name}
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                    <div class="mt-3 flex flex-col gap-1.5 border-t border-[#EDEBE6] pt-3 text-[0.78rem] text-[#8A8781]">
                      {item.shopName && (
                        <span class="flex items-center gap-1.5">
                          <Store size={13} strokeWidth={2} />
                          {item.shopName}
                        </span>
                      )}
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        {item.location && (
                          <span class="flex items-center gap-1.5">
                            <MapPin size={13} strokeWidth={2} />
                            {item.location}
                          </span>
                        )}
                        {item.location && item.officialSite && (
                          <span class="text-[#C7C5BF]">　</span>
                        )}
                        {item.officialSite && (
                          <a
                            href={item.officialSite}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group/link inline-flex items-center gap-1.5 rounded-full border border-[#A24730] px-2.5 py-1 text-[0.7rem] font-medium text-[#A24730] transition-colors hover:bg-[#A24730] hover:text-white"
                          >
                            {content.activitiesSection.officialSiteLinkLabelShort}
                            <ExternalLink
                              size={11}
                              strokeWidth={2}
                              class="transition-transform group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5"
                            />
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</PageTemplate>
<style>
  .search-highlight {
    animation: search-flash 2s ease-out;
  }
  @keyframes search-flash {
    0%,
    40% {
      box-shadow: 0 0 0 3px #a24730;
    }
    100% {
      box-shadow: 0 0 0 3px transparent;
    }
  }
</style>
<script>
  const activityTablist = document.getElementById('activity-tablist');
  const activityTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.activity-tab'));
  const activityCards = Array.from(document.querySelectorAll<HTMLElement>('.activity-card'));
  const ACTIVE_CLASSES = [
    'border-[#A24730]',
    'bg-[#A24730]',
    'text-white',
    'hover:bg-[#8A3B27]',
    'hover:border-[#8A3B27]',
  ];
  const INACTIVE_CLASSES = [
    'border-[#D8D7D2]',
    'bg-white',
    'text-[#55524C]',
    'hover:border-[#A24730]',
    'hover:text-[#A24730]',
    'hover:bg-[#F7EAE5]',
  ];
  function setTabState(tab: HTMLButtonElement, active: boolean) {
    tab.classList.remove(...ACTIVE_CLASSES, ...INACTIVE_CLASSES);
    tab.classList.add(...(active ? ACTIVE_CLASSES : INACTIVE_CLASSES));
  }
  activityTablist?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.activity-tab');
    if (!btn) return;
    const target = btn.dataset['activityCategory'];
    activityTabs.forEach((t) => {
      setTabState(t, t.dataset['activityCategory'] === target);
    });
    activityCards.forEach((card) => {
      const categories = (card.dataset['categories'] ?? '').split(',').filter(Boolean);
      const show = target === 'all' || categories.includes(target ?? '');
      card.style.display = show ? '' : 'none';
    });
  });
  // --- 検索結果からの遷移: ハッシュ一致要素へスクロール＆一瞬ハイライト ---
  function flashHashTarget() {
    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (!hash) return;
    const target = document.getElementById(hash);
    if (!target) return;
    requestAnimationFrame(() => {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('search-highlight');
      setTimeout(() => target.classList.remove('search-highlight'), 2000);
    });
  }
  flashHashTarget();
  window.addEventListener('hashchange', flashHashTarget);
</script>
