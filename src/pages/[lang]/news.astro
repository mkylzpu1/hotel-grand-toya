---
import PageTemplate from '../../layouts/PageTemplate.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import { getCollection } from 'astro:content';
import { type Locale } from '../../content/config';
import { getLocalizedStaticPaths, getPageContext } from '../../utils/pageContext';

export async function getStaticPaths() {
  return getLocalizedStaticPaths('news-page');
}

const { lang } = Astro.params as { lang: Locale };
const { siteEntry, navigationEntry, pageEntry, relatedLinksData, langLinks } = await getPageContext(
  lang,
  'news-page',
  'news',
);
const page = pageEntry.data;

const categoryIdMap: Record<string, string> = {
  お知らせ: 'other',
  イベント: 'event',
  メンテナンス: 'maintenance',
  キャンペーン: 'campaign',
};

const newsEntries = await getCollection('news');
const posts = newsEntries
  .map((entry) => {
    const translated = entry.data.translations[lang];
    const fallback = entry.data.translations.ja;
    return {
      id: entry.data.slug ?? entry.id,
      date: entry.data.date,
      category: entry.data.category,
      isImportant: entry.data.isImportant,
      title: translated.title || fallback.title,
      body: translated.body.length > 0 ? translated.body : fallback.body,
    };
  })
  .filter((post) => post.title)
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---

<PageTemplate
  lang={lang}
  title={`${page.pageTitle}｜${siteEntry.data.title}`}
  description={siteEntry.data.description}
  navigation={navigationEntry.data}
  site={siteEntry.data}
  langLinks={langLinks}
  heroIcon={page.icon}
  pageTitle={page.pageTitle}
  pageTitleEn={page.pageTitleEn}
  showQuickNav={false}
  currentPageId="news"
  relatedLinksHeading={relatedLinksData.heading}
  relatedLinks={relatedLinksData.links}
>
  <section class="mx-auto max-w-[1000px] px-5 lg:px-10 py-[88px] lg:py-[108px]">
    <SectionEyebrow icon={page.icon} eyebrow="News" heading={page.pageTitle} />

    <!-- カテゴリフィルター -->
    <div class="mb-12 mt-10 flex flex-wrap gap-3" data-news-filters>
      <button
        type="button"
        data-filter="all"
        class="news-filter-btn is-active rounded-full border border-[#A24730] bg-[#A24730] px-5 py-2 text-[0.86rem] tracking-[0.04em] text-white transition-colors"
      >
        {page.allCategoryLabel}
      </button>
      {
        page.categoryFilters.map((cat) => (
          <button
            type="button"
            data-filter={cat.id}
            class="news-filter-btn rounded-full border border-[#D8D7D2] bg-white px-5 py-2 text-[0.86rem] tracking-[0.04em] text-[#55524C] transition-colors hover:border-[#A24730] hover:text-[#A24730]"
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <!-- 一覧 -->
    <div class="space-y-0 divide-y divide-[#D8D7D2] border-t border-[#D8D7D2]" data-news-list>
      {
        posts.map((post) => (
          <article
            id={post.id}
            class="news-item flex scroll-mt-24 flex-col gap-2 py-7 sm:flex-row sm:items-baseline sm:gap-8"
            data-category={categoryIdMap[post.category] ?? 'other'}
          >
            <div class="flex shrink-0 items-center gap-4 sm:w-[180px]">
              <time class="text-[0.82rem] tracking-[0.04em] text-[#8A8781]">{post.date}</time>
              <span class="rounded-[2px] border border-[#A24730]/40 px-2.5 py-1 text-[0.72rem] tracking-[0.03em] text-[#A24730]">
                {post.category}
              </span>
            </div>
            <div class="flex-1">
              <h3 class="mb-2 font-serif text-[1.02rem] font-semibold text-[#1E1C1A]">
                {post.isImportant && <span class="mr-2 text-[#A24730]">【重要】</span>}
                {post.title}
              </h3>
              {post.body.map((line) => (
                <p class="mb-2 text-[0.88rem] leading-[1.9] text-[#55524C] last:mb-0">{line}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <!-- 「お知らせはありません」表示：記事が0件の時／絞り込み結果が0件の時の両方で使う -->
    <p
      id="news-empty"
      class="hidden py-10 text-center text-[0.9rem] text-[#8A8781]"
      data-news-empty
    >
      {page.emptyLabel}
    </p>
  </section>

  <script is:inline>
    (function () {
      const buttons = document.querySelectorAll('.news-filter-btn');
      const items = document.querySelectorAll('.news-item');
      const emptyMessage = document.getElementById('news-empty');

      function updateEmptyState(filter) {
        const visibleCount = Array.from(items).filter((item) => {
          const category = item.getAttribute('data-category');
          return filter === 'all' || filter === category;
        }).length;
        if (emptyMessage) {
          emptyMessage.classList.toggle('hidden', visibleCount !== 0);
        }
      }

      function applyFilter(filter) {
        buttons.forEach((b) => {
          const active = b.getAttribute('data-filter') === filter;
          b.classList.toggle('is-active', active);
          b.classList.toggle('bg-[#A24730]', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('border-[#A24730]', active);
          b.classList.toggle('bg-white', !active);
          b.classList.toggle('text-[#55524C]', !active);
          b.classList.toggle('border-[#D8D7D2]', !active);
        });
        items.forEach((item) => {
          const category = item.getAttribute('data-category');
          const show = filter === 'all' || filter === category;
          item.style.display = show ? '' : 'none';
        });
        updateEmptyState(filter);
      }

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-filter'));
        });
      });

      // --- 検索結果からの遷移: ハッシュ一致記事へスクロール＆一瞬ハイライト ---
      function flashHashTarget() {
        const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
        if (!hash) return;
        const target = document.getElementById(hash);
        if (!target) return;

        // 現在のフィルターで隠れている場合は「すべて」に戻す
        if (target.style.display === 'none') {
          applyFilter('all');
        }

        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.classList.add('search-highlight');
          setTimeout(() => target.classList.remove('search-highlight'), 2000);
        });
      }

      // 初期表示（記事が0件の場合にも対応）
      updateEmptyState('all');
      flashHashTarget();
      window.addEventListener('hashchange', flashHashTarget);
    })();
  </script>

  <style>
    /* 選択中のタブは hover しても背景色と文字色を固定する
       （hover:text-[#A24730] とぶつかって文字が見えなくなるのを防止） */
    .news-filter-btn.is-active:hover {
      background-color: #a24730;
      border-color: #a24730;
      color: #ffffff;
    }

    .search-highlight {
      animation: search-flash 2s ease-out;
    }
    @keyframes search-flash {
      0%,
      40% {
        box-shadow: 0 0 0 3px #a24730;
      }
      100% {
        box-shadow: 0 0 0 3px transparent;
      }
    }
  </style>
</PageTemplate>
