---
import PageTemplate from '../../layouts/PageTemplate.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import { getEntry } from 'astro:content';
import { type Locale } from '../../content/config';
import {
  getLocalizedStaticPaths,
  getCommonPageContext,
  getLangLinks,
} from '../../utils/pageContext';
export async function getStaticPaths() {
  return getLocalizedStaticPaths('onsen-page-meta');
}
const { lang } = Astro.params as { lang: Locale };
const [common, langLinks, metaEntry, qualityEntry, facilitiesEntry, stayEntry, dayUseEntry] =
  await Promise.all([
    getCommonPageContext(lang),
    getLangLinks(lang, 'onsen-page-meta', 'onsen'),
    getEntry('onsen-page-meta', `onsen-page-meta.${lang}`),
    getEntry('onsen-quality', `onsen-quality.${lang}`),
    getEntry('onsen-facilities', `onsen-facilities.${lang}`),
    getEntry('onsen-usage-stay', `onsen-usage-stay.${lang}`),
    getEntry('onsen-usage-dayuse', `onsen-usage-dayuse.${lang}`),
  ]);
const { siteEntry, navigationEntry, relatedLinksData } = common;

const dayUseItems = (dayUseEntry!.data.items ??
  [
    dayUseEntry!.data.fee,
    dayUseEntry!.data.receptionHours,
    dayUseEntry!.data.usageHours,
    dayUseEntry!.data.usageNotes,
  ].filter(Boolean)) as Array<{ label: string; value: string }>;

const page = {
  ...metaEntry!.data,
  facilities: facilitiesEntry!.data,
  quality: {
    ...qualityEntry!.data,
    items: [
      qualityEntry!.data.waterQuality,
      qualityEntry!.data.benefits,
      qualityEntry!.data.characteristics,
      qualityEntry!.data.sourceInfo,
    ],
  },
  stay: {
    ...stayEntry!.data,
    items: [stayEntry!.data.hours, stayEntry!.data.amenities, stayEntry!.data.usageNotes],
  },
  dayUse: {
    ...dayUseEntry!.data,
    items: dayUseItems,
    rentals: dayUseEntry!.data.rentals ?? [],
    notes: dayUseEntry!.data.notes ?? [],
  },
};
---

<PageTemplate
  lang={lang}
  title={`${page.pageTitle}｜${siteEntry.data.title}`}
  description={siteEntry.data.description}
  navigation={navigationEntry.data}
  site={siteEntry.data}
  langLinks={langLinks}
  heroIcon={page.icon}
  pageTitle={page.pageTitle}
  pageTitleEn={page.pageTitleEn}
  quickNav={page.quickNav}
  quickNavLabel="ページ内ナビゲーション"
  currentPageId="onsen"
  relatedLinksHeading={relatedLinksData.heading}
  relatedLinks={relatedLinksData.links}
  reservationLabel={siteEntry.data.reservationLabel}
>
  <!-- 温泉施設紹介 -->
  <section id="facilities" class="relative py-[88px] lg:py-[108px]">
    <div class="mx-auto max-w-[1320px] px-5 lg:px-10">
      <SectionEyebrow
        icon={page.facilities.icon}
        eyebrow={page.facilities.eyebrow}
        heading={page.facilities.heading}
      />
      <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
        {
          page.facilities.items.map((facility) => (
            <article>
              <div class="mb-5 aspect-[4/5] overflow-hidden">
                <img
                  src={facility.image}
                  alt={facility.imageAlt}
                  class="h-full w-full object-cover"
                />
              </div>
              <h3 class="mb-2.5 font-serif text-[1.15rem] font-semibold text-[#1E1C1A]">
                {facility.name}
              </h3>
              <p class="mb-3.5 text-[0.88rem] leading-[1.9] text-[#55524C]">
                {facility.description}
              </p>
              <p class="text-[0.78rem] tracking-[0.04em] text-[#8A8781]">
                <span class="text-[#29415C]">{page.facilities.hoursLabel}</span> {facility.hours}
              </p>
            </article>
          ))
        }
      </div>
      <div class="mt-10 border-t border-[#D8D7D2] pt-6">
        {
          page.facilities.notes && page.facilities.notes.length > 0 && (
            <div class="mx-auto mt-4 max-w-[1320px]">
              {page.facilities.notes.map((note) => (
                <div class="flex items-start gap-3 border border-[#A24730]/30 bg-[#FAF6F3] px-5 py-4">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#A24730] text-[0.68rem] font-bold text-[#A24730]">
                    !
                  </span>
                  <p class="text-[0.84rem] leading-[1.85] text-[#55524C]">{note}</p>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>
  <!-- 泉質・効能 -->
  <section id="quality" class="relative mx-auto bg-[#FAFAFA] px-5 py-[88px] lg:px-10 lg:py-[108px]">
    <div class="mx-auto max-w-[1320px]">
      <SectionEyebrow
        icon={page.quality.icon}
        eyebrow={page.quality.eyebrow}
        heading={page.quality.heading}
      />
      <dl class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
        {
          page.quality.items.map((item) => (
            <div class="border-t border-[#cdcdca] pt-5">
              <dt class="mb-2 text-[0.78rem] font-medium tracking-[0.12em] text-[#29415C]">
                {item.label}
              </dt>
              <dd class="m-0 text-[0.94rem] leading-[1.9] text-[#55524C]">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
  <!-- 利用案内：宿泊 / 日帰り -->
  <section id="useage" class="mx-auto max-w-[1320px] px-5 py-[88px] lg:px-10 lg:py-[108px]">
    <div class="mb-14 text-center">
      <h2 class="font-serif text-[clamp(1.5rem,1.2rem+1.1vw,2.05rem)] font-semibold text-[#1E1C1A]">
        {page.usageHeading}
      </h2>
    </div>
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-2 lg:gap-16">
      <!-- 宿泊 -->
      <div id={page.stay.id} class="scroll-mt-6 border border-[#a1a19e] p-9 lg:p-11">
        <SectionEyebrow
          icon={page.stay.icon}
          eyebrow={page.stay.eyebrow}
          heading={page.stay.heading}
          compact
        />
        <dl class="mt-8 space-y-6">
          {
            page.stay.items.map((item) => (
              <div class="border-t border-[#cdcdca] pt-4">
                <dt class="mb-1.5 text-[0.78rem] font-medium tracking-[0.1em] text-[#29415C]">
                  {item.label}
                </dt>
                <dd class="m-0 text-[0.88rem] leading-[1.85] text-[#55524C]">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <!-- 日帰り -->
      <div id={page.dayUse.id} class="scroll-mt-6 border border-[#A24730] p-9 lg:p-11">
        <SectionEyebrow
          icon={page.dayUse.icon}
          eyebrow={page.dayUse.eyebrow}
          heading={page.dayUse.heading}
          compact
        />
        <dl class="mt-8 space-y-6">
          {
            page.dayUse.items.map((item) => (
              <div class="border-t border-[#cdcdca] pt-4">
                <dt class="mb-1.5 text-[0.78rem] font-medium tracking-[0.1em] text-[#29415C]">
                  {item.label}
                </dt>
                <dd class="m-0 text-[0.88rem] leading-[1.85] text-[#55524C]">{item.value}</dd>
              </div>
            ))
          }
          {
            page.dayUse.rentals && page.dayUse.rentals.length > 0 && (
              <div class="border-t border-[#cdcdca] pt-4">
                <dt class="mb-1.5 text-[0.78rem] font-medium tracking-[0.1em] text-[#29415C]">
                  {page.dayUse.rentalsLabel}
                </dt>
                <dd class="m-0">
                  <div class="space-y-2">
                    {page.dayUse.rentals.map((item) => (
                      <div class="flex items-center justify-between text-[0.88rem] leading-[1.85] text-[#55524C]">
                        <span>{item.label}</span>
                        <span class="text-[#55524C]">{item.value}</span>
                      </div>
                    ))}
                  </div>
                  {page.dayUse.notes && page.dayUse.notes.length > 0 && (
                    <div class="mt-3 space-y-1">
                      {page.dayUse.notes.map((note) => (
                        <p class="m-0 text-[0.8rem] leading-[1.7]">※{note}</p>
                      ))}
                    </div>
                  )}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </section>
  <!-- ▲ ここまで温泉ページ固有のコンテンツ ▲ -->
</PageTemplate>
