---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import { locales, localeFromId, type Locale } from '../../content/config';
import { getRelatedLinksData } from '../../utils/relatedLinks';
import RelatedLinks from '../../components/common/RelatedLinks.astro';

const LANG_LABELS: Record<Locale, string> = {
  ja: 'JP',
  en: 'EN',
  zh: 'CH',
  ko: 'KR',
};

export async function getStaticPaths() {
  // onsen-page のコンテンツが用意されている言語のみビルドする
  const entries = await getCollection('onsen-page');
  return entries.map((entry) => ({ params: { lang: localeFromId(entry.id) } }));
}

const { lang } = Astro.params as { lang: Locale };
const homeHref = `/${lang}/`;

const [siteEntry, navigationEntry, onsenEntry] = await Promise.all([
  getEntry('site', `site.${lang}`),
  getEntry('navigation', `navigation.${lang}`),
  getEntry('onsen-page', `onsen-page.${lang}`),
]);

if (!siteEntry || !navigationEntry || !onsenEntry) {
  throw new Error(`Missing content for locale "${lang}". Check src/content/*/*.${lang}.json`);
}

const page = onsenEntry.data;
const { reservationUrl } = siteEntry.data;
const relatedLinksData = await getRelatedLinksData(lang, reservationUrl);

// 利用可能な言語のみ切り替えリンクを出す（onsen-page が無い言語には遷移させない）
const availableOnsenEntries = await getCollection('onsen-page');
const availableLocales = new Set(availableOnsenEntries.map((entry) => localeFromId(entry.id)));

const langLinks = locales
  .filter((code) => availableLocales.has(code))
  .map((code) => ({
    code,
    label: LANG_LABELS[code],
    href: `/${code}/onsen/`,
    active: code === lang,
  }));
---

<Layout
  lang={lang}
  title={`${page.pageTitle}｜${siteEntry.data.title}`}
  description={siteEntry.data.description}
  navigation={navigationEntry.data}
  site={siteEntry.data}
  langLinks={langLinks}
>
  <main id="top">
    <!-- ページタイトル帯（ヒーローではなく、ヘッダーの視認性を確保するための最小限のダーク帯） -->
    <section class="relative overflow-hidden bg-[#16283A] pb-14 pt-[132px] text-white lg:pb-[68px] lg:pt-[136px]">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-6 -top-16 select-none font-serif text-[220px] leading-none text-white/[0.05] lg:-right-4 lg:-top-24 lg:text-[300px]"
      >
        {page.quality.icon}
      </span>
      <div class="relative mx-auto max-w-[1320px] px-10">
        <!-- パンくずリスト -->
        <nav aria-label="パンくずリスト" class="mb-7">
          <ol class="flex flex-wrap items-center gap-2 text-[0.74rem] tracking-[0.06em] text-white/50">
            <li>
              <a href={homeHref} class="transition-colors hover:text-white">ホーム</a>
            </li>
            <li aria-hidden="true" class="text-white/30">/</li>
            <li class="text-white/85" aria-current="page">{page.pageTitle}</li>
          </ol>
        </nav>
        <p class="mb-4 text-[0.78rem] font-medium tracking-[0.2em] text-white/60">
          {page.pageTitleEn}
        </p>
        <h1 class="font-serif text-[clamp(1.9rem,1.5rem+1.6vw,2.6rem)] font-semibold tracking-[0.06em] text-white">
          {page.pageTitle}
        </h1>
      </div>
    </section>

    <!-- 利用区分への導線 -->
    <nav aria-label="利用区分" class="border-b border-[#D8D7D2] bg-[#FAFAFA]">
      <div class="mx-auto grid max-w-[1320px] grid-cols-1 gap-px sm:grid-cols-2">
        {
          page.usageNav.map((item) => (
            <a
              href={item.href}
              class="group flex items-center justify-between gap-4 px-10 py-8 transition-colors hover:bg-white"
            >
              <span class="font-sans text-[1.3rem] font-medium tracking-[0.02em] text-[#1E1C1A]">
                {item.label}
              </span>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#A24730] text-[0.95rem] text-[#A24730] transition-transform duration-300 group-hover:translate-x-1">
                ↓
              </span>
            </a>
          ))
        }
      </div>
    </nav>

<!-- 泉質・効能 -->
    <section
      id="quality"
      class="relative mx-auto max-w-[1320px] px-10 py-[88px] lg:py-[108px]"
    >
      <SectionEyebrow icon={page.quality.icon} eyebrow={page.quality.eyebrow} heading={page.quality.heading} />
      <dl class="mt-12 grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2">
        {
          page.quality.items.map((item) => (
            <div class="border-t border-[#cdcdca] pt-5">
              <dt class="mb-2 text-[0.78rem] font-medium tracking-[0.12em] text-[#29415C]">
                {item.label}
              </dt>
              <dd class="m-0 text-[0.94rem] leading-[1.9] text-[#55524C]">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- 温泉施設紹介（宿泊・日帰り共通） -->
    <section class="relative bg-[#FAFAFA] py-[88px] lg:py-[108px]">
      <div class="mx-auto max-w-[1320px] px-10">
        <SectionEyebrow
          icon={page.facilities.icon}
          eyebrow={page.facilities.eyebrow}
          heading={page.facilities.heading}
        />
        <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-3">
          {
            page.facilities.items.map((facility) => (
              <article>
                <div class="mb-5 aspect-[4/5] overflow-hidden">
                  <img src={facility.image} alt={facility.imageAlt} class="h-full w-full object-cover" />
                </div>
                <h3 class="mb-2.5 font-serif text-[1.15rem] font-semibold text-[#1E1C1A]">
                  {facility.name}
                </h3>
                <p class="mb-3.5 text-[0.88rem] leading-[1.9] text-[#55524C]">{facility.description}</p>
                <p class="text-[0.78rem] tracking-[0.04em] text-[#8A8781]">
                  <span class="text-[#29415C]">利用時間</span> {facility.hours}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

<!-- 利用案内：宿泊 / 日帰り -->
    <section class="mx-auto max-w-[1320px] px-10 py-[88px] lg:py-[108px]">
      <div class="mb-14 text-center">
        <h2 class="font-serif text-[clamp(1.5rem,1.2rem+1.1vw,2.05rem)] font-semibold text-[#1E1C1A]">
          利用案内
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-14 lg:grid-cols-2 lg:gap-16">
        <!-- 宿泊 -->
        <div id={page.stay.id} class="scroll-mt-6 border  border-[#a1a19e] p-9 lg:p-11">
          <SectionEyebrow icon={page.stay.icon} eyebrow={page.stay.eyebrow} heading={page.stay.heading} compact />
          <dl class="mt-8 space-y-6">
            {
              page.stay.items.map((item) => (
                <div class="border-t  border-[#cdcdca] pt-4">
                  <dt class="mb-1.5 text-[0.78rem] font-medium tracking-[0.1em] text-[#29415C]">
                    {item.label}
                  </dt>
                  <dd class="m-0 text-[0.88rem] leading-[1.85] text-[#55524C]">{item.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <!-- 日帰り -->
        <div id={page.dayUse.id} class="scroll-mt-6 border border-[#A24730] p-9 lg:p-11">
          <SectionEyebrow
            icon={page.dayUse.icon}
            eyebrow={page.dayUse.eyebrow}
            heading={page.dayUse.heading}
            compact
          />
          <dl class="mt-8 space-y-6">
            {
              page.dayUse.items.map((item) => (
                <div class="border-t border-[#cdcdca] pt-4">
                  <dt class="mb-1.5 text-[0.78rem] font-medium tracking-[0.1em] text-[#29415C]">
                    {item.label}
                  </dt>
                  <dd class="m-0 text-[0.88rem] leading-[1.85] text-[#55524C]">{item.value}</dd>
                </div>
              ))
            }
            {
              page.dayUse.rentals && page.dayUse.rentals.length > 0 && (
                <div class="border-t border-[#cdcdca] pt-4">
                  <dt class="mb-1.5 text-[0.78rem] font-medium tracking-[0.1em] text-[#29415C]">
                    レンタル品・料金
                  </dt>
                  <dd class="m-0">
                    <div class="space-y-2">
                      {page.dayUse.rentals.map((item) => (
                        <div class="flex items-center justify-between text-[0.88rem] leading-[1.85] text-[#55524C]">
                          <span>{item.label}</span>
                          <span class="text-[#55524C]">{item.value}</span>
                        </div>
                      ))}
                    </div>
                    {page.dayUse.notes && page.dayUse.notes.length > 0 && (
                      <div class="mt-3 space-y-1">
                        {page.dayUse.notes.map((note) => (
                          <p class="m-0 text-[0.8rem] leading-[1.7]">※{note}</p>
                        ))}
                      </div>
                    )}
                  </dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- 関連ページへの導線 -->
    <RelatedLinks
      heading={relatedLinksData.heading}
      links={relatedLinksData.links}
      currentPageId="rooms"
      background="white"
    />
  </main>
</Layout>
