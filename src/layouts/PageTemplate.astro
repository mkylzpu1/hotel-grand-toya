---
// src/layouts/PageTemplate.astro
import Layout from './Layout.astro';
import PageHeroBand from '../components/common/PageHeroBand.astro';
import RelatedLinks from '../components/common/RelatedLinks.astro';
import type { Locale } from '../content/config';
import type { LangLink, NavigationContent, RelatedLink, SiteContent } from '../types/site';
import { asset } from '../utils/asset';

interface QuickNavItem {
  href: string;
  label: string;
}
interface Props {
  lang: Locale;
  title: string;
  description: string;
  navigation: NavigationContent;
  site: SiteContent;
  langLinks: LangLink[];
  heroIcon: string;
  pageTitle: string;
  pageTitleEn: string;
  showQuickNav?: boolean;
  quickNav?: QuickNavItem[];
  quickNavLabel?: string;
  currentPageId: string;
  relatedLinksHeading: string;
  relatedLinks: RelatedLink[];
  relatedLinksBackground?: 'white' | 'none';
  showRelatedLinks?: 'true' | 'false';
}
const {
  lang,
  title,
  description,
  navigation,
  site,
  langLinks,
  heroIcon,
  pageTitle,
  pageTitleEn,
  showQuickNav = true,
  quickNav,
  quickNavLabel = 'ページ内メニュー',
  currentPageId,
  relatedLinksHeading,
  relatedLinks,
  relatedLinksBackground = 'white',
  showRelatedLinks = 'true',
} = Astro.props;
const shouldShowQuickNav = showQuickNav && quickNav && quickNav.length > 0;
---

<Layout
  lang={lang}
  title={title}
  description={description}
  navigation={navigation}
  site={site}
  langLinks={langLinks}
>
  <main id="top">
    <!-- ページタイトル帯（全ページ共通） -->
    <PageHeroBand
      icon={heroIcon}
      pageTitle={pageTitle}
      pageTitleEn={pageTitleEn}
      homeHref={asset(`/${lang}/`)}
    />
    <!-- ページ内アンカーナビ（全ページ共通・フラグで表示切替） -->
    <!-- ページ内アンカーナビ（全ページ共通・フラグで表示切替） -->
    {
      shouldShowQuickNav && (
        <nav aria-label={quickNavLabel} class="border-b border-[#D8D7D2] bg-[#FAFAFA]">
          <div
            class="quick-nav mx-auto grid max-w-[1320px] grid-cols-2"
            style={`--nav-count: ${quickNav!.length};`}
          >
            {quickNav!.map((item, index) => (
              <a
                href={item.href}
                class:list={[
                  'quick-nav-item group flex items-center justify-center gap-2 px-4 py-5 text-center transition-colors hover:bg-white',
                  { 'quick-nav-item--wide': quickNav!.length === 3 && index === 2 },
                ]}
              >
                <span class="break-keep font-serif text-[0.9rem] font-medium leading-snug tracking-[0.02em] text-[#1E1C1A]">
                  {item.label}
                </span>
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#A24730] text-[0.7rem] text-[#A24730] transition-transform duration-300 group-hover:translate-x-1">
                  ↓
                </span>
              </a>
            ))}
          </div>
        </nav>
      )
    }
    <!-- ▼ ページ固有のコンテンツ ▼ -->
    <slot />
    <!-- ▲ ここまで ▲ -->
    <!-- 関連ページへの導線（全ページ共通） -->
    {
      showRelatedLinks === 'true' && (
        <RelatedLinks
          heading={relatedLinksHeading}
          links={relatedLinks}
          currentPageId={currentPageId}
          background={relatedLinksBackground}
        />
      )
    }
  </main>

  <!-- 検索結果からの遷移時に、該当箇所をハイライトする -->
  <script is:inline>
    (function () {
      const params = new URLSearchParams(window.location.search);
      const term = params.get('highlight');
      if (!term || !term.trim()) return;

      const target = term.trim();

      function collectMatches(root) {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
            const tag = node.parentElement && node.parentElement.tagName;
            if (tag === 'SCRIPT' || tag === 'STYLE') return NodeFilter.FILTER_REJECT;
            return NodeFilter.FILTER_ACCEPT;
          },
        });
        const matches = [];
        let node;
        while ((node = walker.nextNode())) {
          const idx = node.nodeValue.toLowerCase().indexOf(target.toLowerCase());
          if (idx !== -1) matches.push({ node, idx });
        }
        return matches;
      }

      // アンカー先のセクションがあればその中だけ探す（無関係な箇所の誤ハイライトを防ぐ）
      const hash = window.location.hash.replace('#', '');
      const scope = (hash && document.getElementById(hash)) || document.body;

      let matches = collectMatches(scope);
      // アンカー内で見つからなければページ全体にフォールバック
      if (matches.length === 0 && scope !== document.body) {
        matches = collectMatches(document.body);
      }
      if (matches.length === 0) return;

      const { node, idx } = matches[0];
      const range = document.createRange();
      range.setStart(node, idx);
      range.setEnd(node, idx + target.length);
      const mark = document.createElement('mark');
      mark.className = 'search-highlight';
      range.surroundContents(mark);

      requestAnimationFrame(() => {
        mark.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    })();
  </script>

  <style is:global>
    mark.search-highlight {
      background-color: #ffff00;
      color: #1e1c1a;
      padding: 1px 4px;
      border-radius: 2px;
      box-shadow: 0 0 0 3px rgba(255, 255, 0, 0.4);
    }
    .quick-nav-item {
      border-left: 1px solid #d8d7d2;
      border-top: 1px solid #d8d7d2;
    }
    /* モバイル：2カラム前提のボーダー調整 */
    .quick-nav-item:nth-child(2n + 1) {
      border-left: none;
    }
    .quick-nav-item:nth-child(-n + 2) {
      border-top: none;
    }
    /* 3件のときだけ、3番目を下段フル幅に */
    .quick-nav-item--wide {
      grid-column: 1 / -1;
    }

    @media (min-width: 768px) {
      .quick-nav {
        grid-template-columns: repeat(var(--nav-count), minmax(0, 1fr));
      }
      .quick-nav-item {
        padding: 1.75rem 2.5rem;
        gap: 0.75rem;
        border-top: none !important;
      }
      .quick-nav-item:nth-child(n) {
        border-left: 1px solid #d8d7d2;
      }
      .quick-nav-item:first-child {
        border-left: none;
      }
      .quick-nav-item--wide {
        grid-column: auto;
      }
      .quick-nav-item span:first-child {
        font-size: 1.1rem;
        letter-spacing: 0.04em;
      }
      .quick-nav-item span:last-child {
        height: 2.25rem;
        width: 2.25rem;
        font-size: 0.9rem;
      }
    }
  </style>
</Layout>
