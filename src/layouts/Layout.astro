---
import '../styles/global.css';
import Header from './Header';
import Footer from './Footer';

const {
  title = 'ホテルグランドトーヤ｜洞爺湖温泉・湖畔のリゾートホテル',
  description = '洞爺湖の湖畔に、いちばん近い時間を。源泉かけ流しの温泉と湖を望む客室で過ごす、静かなひととき。ホテルグランドトーヤ公式サイトです。',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Header client:load />
    <slot />
    <Footer />
  </body>
</html>
