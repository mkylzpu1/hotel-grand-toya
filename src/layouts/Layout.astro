---
import '../styles/global.css';
import Header from './Header';
import Footer from './Footer';
import { locales, type Locale } from '../content/config';
interface LangLink {
  code: Locale;
  label: string;
  href: string;
  active: boolean;
}
interface Props {
  lang: Locale;
  title: string;
  description: string;
  navigation: {
    primaryNavItems: { href: string; label: string; en: string; icon: string }[];
    secondaryNavItems: { href: string; label: string }[];
    reserveCta: string;
    phoneAriaLabel: string;
    menuOpenLabel: string;
    menuCloseLabel: string;
    siteInfoHeading: string;
  };
  site: {
    address: string;
    tel: string;
    reservationUrl: string;
    footer: {
      guideHeading: string;
      infoHeading: string;
      reservationHeading: string;
      reservationExternalText: string;
      copyright: string;
      mobileTelLabel: string;
      mobileReserveLabel: string;
    };
  };
  langLinks: LangLink[];
}
const { lang, title, description, navigation, site, langLinks } = Astro.props;
const logoAlt = 'ホテルグランドトーヤのロゴ';
const navAriaLabel = 'グローバルナビゲーション';
const drawerNavAriaLabel = 'ドロワーナビゲーション';
const searchOpenLabel = 'サイト内検索を開く';
const searchPlaceholder = '客室名やキーワードで検索';
const searchNoResultsLabel = '該当する情報が見つかりませんでした';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      locales.map((l) => {
        const link = langLinks.find((ll) => ll.code === l);
        return link ? <link rel="alternate" hreflang={l} href={new URL(link.href, Astro.site ?? Astro.url.origin)} /> : null;
      })
    }
  </head>
  <body>
    <Header
      client:load
      primaryNavItems={navigation.primaryNavItems}
      secondaryNavItems={navigation.secondaryNavItems}
      reserveCta={navigation.reserveCta}
      phoneAriaLabel={navigation.phoneAriaLabel}
      menuOpenLabel={navigation.menuOpenLabel}
      menuCloseLabel={navigation.menuCloseLabel}
      siteInfoHeading={navigation.siteInfoHeading}
      reservationUrl={site.reservationUrl}
      tel={site.tel}
      logoAlt={logoAlt}
      navAriaLabel={navAriaLabel}
      drawerNavAriaLabel={drawerNavAriaLabel}
      langLinks={langLinks}
      searchIndexUrl={`/${lang}/search-index.json`}
      searchOpenLabel={searchOpenLabel}
      searchPlaceholder={searchPlaceholder}
      searchNoResultsLabel={searchNoResultsLabel}
    />
    <slot />
    <Footer
      guideLinks={navigation.primaryNavItems}
      infoLinks={navigation.secondaryNavItems}
      copy={site.footer}
      address={site.address}
      tel={site.tel}
      reservationUrl={site.reservationUrl}
      logoAlt="Hotel Grand Toya"
    />
  </body>
</html>
