---
import '../styles/global.css';
import Header from './Header';
import Footer from './Footer';
import { locales, type Locale } from '../content/config';
import type { LangLink, NavigationContent, SiteContent } from '../types/site';
import bgTexture from '../../public/assets/textures/bg_v4_2x.jpg';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  navigation: NavigationContent;
  site: SiteContent;
  langLinks: LangLink[];
  ogImage?: string;
}

const { lang, title, description, navigation, site, langLinks, ogImage } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const resolvedOgImage = new URL(
  ogImage ?? `${import.meta.env.BASE_URL}assets/photos/ogp.jpg`,
  Astro.site ?? Astro.url.origin,
);

const ogLocaleMap: Record<Locale, string> = {
  ja: 'ja_JP',
  en: 'en_US',
  zh: 'zh_CN',
  ko: 'ko_KR',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`${import.meta.env.BASE_URL}en/`, Astro.site ?? Astro.url.origin)}
    />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/x-icon"
      href={`${import.meta.env.BASE_URL}assets/favicon/favicon.ico`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${import.meta.env.BASE_URL}assets/favicon/favicon-16x16.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${import.meta.env.BASE_URL}assets/favicon/favicon-32x32.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={`${import.meta.env.BASE_URL}assets/favicon/favicon-48x48.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${import.meta.env.BASE_URL}assets/favicon/apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}assets/favicon/site.webmanifest`} />
    <meta name="theme-color" content="#12172D" />

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={ogLocaleMap[lang]} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {
      locales.map((l) => {
        const link = langLinks.find((ll) => ll.code === l);
        return link ? (
          <link
            rel="alternate"
            hreflang={l}
            href={new URL(link.href, Astro.site ?? Astro.url.origin)}
          />
        ) : null;
      })
    }
  </head>
  <body style={`--bg-texture-url: url(${bgTexture.src})`}>
    <Header
      client:load
      lang={lang}
      primaryNavItems={navigation.primaryNavItems}
      secondaryNavItems={navigation.secondaryNavItems}
      reserveCta={navigation.reserveCta}
      phoneAriaLabel={navigation.phoneAriaLabel}
      menuOpenLabel={navigation.menuOpenLabel}
      menuCloseLabel={navigation.menuCloseLabel}
      siteInfoHeading={navigation.siteInfoHeading}
      reservationUrl={site.reservationUrl}
      tel={site.tel}
      logoAlt={navigation.logoAlt}
      navAriaLabel={navigation.navAriaLabel}
      drawerNavAriaLabel={navigation.drawerNavAriaLabel}
      langLinks={langLinks}
      langSwitcherLabel={navigation.langSwitcherLabel}
      searchIndexUrl={`${import.meta.env.BASE_URL}${lang}/search-index.json`}
      searchOpenLabel={navigation.search.openLabel}
      searchPlaceholder={navigation.search.placeholder}
      searchNoResultsLabel={navigation.search.noResultsLabel}
      searchEmptyStateLabel={navigation.search.emptyStateLabel}
      searchNavigateHintLabel={navigation.search.navigateHintLabel}
      searchOpenHintLabel={navigation.search.openHintLabel}
      searchClearButtonLabel={navigation.search.clearButtonLabel}
      bottomNavSearchLabel={navigation.bottomNav.searchLabel}
      bottomNavTelLabel={navigation.bottomNav.telLabel}
      bottomNavReserveLabel={navigation.bottomNav.reserveLabel}
      bottomNavMenuLabel={navigation.bottomNav.menuLabel}
    />
    <main class="pb-16 lg:pb-0">
      <slot />
    </main>
    <Footer
      guideLinks={navigation.primaryNavItems}
      infoLinks={navigation.secondaryNavItems}
      copy={site.footer}
      address={site.address}
      tel={site.tel}
      fax={site.fax}
      email={site.email}
      reservationUrl={site.reservationUrl}
      logoAlt={navigation.logoAlt}
      logoSrc={`${import.meta.env.BASE_URL}assets/photos/ttl.png`}
    />
  </body>
</html>
